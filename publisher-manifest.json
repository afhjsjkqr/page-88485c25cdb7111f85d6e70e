:1fr 1fr;gap:12px}\n.qa{border:1.5px dashed #d9d1c8;border-radius:6px;padding:16px 18px;background:#fff}\n.qa h3{font-size:15.5px;margin:0 0 6px;line-height:1.5}\n.qa h3::before{content:\"Q \";color:#ff5500;font-weight:800}\n.qa p{margin:0;font-size:14px;color:#4c443d}\nfooter{border-top:2px solid #16130f;margin-top:60px}\nfooter .wrap{max-width:1080px;margin:0 auto;padding:22px 20px 48px;font-size:12.5px;color:#6d635b;line-height:1.75}\nfooter p{margin:0 0 6px}\nfooter p:last-child{margin-bottom:0}\nfooter strong{color:#16130f;letter-spacing:.14em}\n@media(max-width:600px){\n  .steps li{grid-template-columns:38px 1fr;gap:10px;padding:13px 14px}\n  .steps .n{font-size:20px}\n  .faq{grid-template-columns:1fr}\n}\n@media(max-width:760px){\n  .faq{grid-template-columns:1fr}\n}\n</style><header class=\"masthead\">\n  <div class=\"logo\">MLLSS<span>.</span></div>\n  <p>套餐 · 客户端 · 使用说明</p>\n</header>\n\n<main>\n\n  <div class=\"hero\">\n    <p class=\"kicker\">MLLSS 信息页</p>\n    <h1>MLLSS 机场：三档套餐、四类客户端、五步上手</h1>\n    <p class=\"lede\">把价格、流量、同时在线设备数、客户端怎么选和第一次怎么连，按顺序排在同一页里。没有二级页面，从首屏这几个方块开始往下读就行。</p>\n\n    <div class=\"tiles\">\n      <div class=\"tile tile--accent\">\n        <span class=\"lab\">起步档</span>\n        <span class=\"val\">¥15<small> /月</small></span>\n        <span class=\"sub\">基础版 · 年付 ¥150</span>\n      </div>\n      <div class=\"tile\">\n        <span class=\"lab\">主推档</span>\n        <span class=\"val\">¥35<small> /月</small></span>\n        <span class=\"sub\">旗舰版 · 年付 ¥350</span>\n      </div>\n      <div class=\"tile\">\n        <span class=\"lab\">最高档</span>\n        <span class=\"val\">¥85<small> /月</small></span>\n        <span class=\"sub\">团队版 · 年付 ¥850</span>\n      </div>\n      <div class=\"tile\">\n        <span class=\"lab\">每月流量</span>\n        <span class=\"val\">100<small>–1000GB</small></span>\n        <span class=\"sub\">随档位递增</span>\n      </div>\n      <div class=\"tile\">\n        <span class=\"lab\">同时在线</span>\n        <span class=\"val\">3<small>–20 台</small></span>\n        <span class=\"sub\">随档位递增</span>\n      </div>\n    </div>\n\n    <nav class=\"jump\" aria-label=\"页面内跳转\">\n      <a href=\"#plans\">套餐对比</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#guide\">使用说明</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n\n  <section id=\"plans\">\n    <div class=\"sec-head\">\n      <h2>三档套餐横向对比</h2>\n      <p>价格、流量、设备数和线路说明并排放，横向看一列就是一个完整的档位。</p>\n    </div>\n\n    <div class=\"table-wrap\">\n      <table>\n        MLLSS 套餐对照（整理自参考方案，最终价格权益以购买渠道页面为准）\n        <thead>\n          <tr>\n            <th>对比项</th>\n            <th>基础版</th>\n            <th>旗舰版<span class=\"badge\">推荐</span></th>\n            <th>团队版</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <th>月付价格</th>\n            <td><span class=\"col-price\">¥15</span> /月</td>\n            <td><span class=\"col-price\">¥35</span> /月</td>\n            <td><span class=\"col-price\">¥85</span> /月</td>\n          </tr>\n          <tr>\n            <th>按年付价格</th>\n            <td><span class=\"col-price\">¥150</span> /年</td>\n            <td><span class=\"col-price\">¥350</span> /年</td>\n            <td><span class=\"col-price\">¥850</span> /年</td>\n          </tr>\n          <tr>\n            <th>每月流量</th>\n            <td>100GB 极速流量</td>\n            <td>300GB 极速流量</td>\n            <td>1000GB 极速流量</td>\n          </tr>\n          <tr>\n            <th>同时在线设备</th>\n            <td>3 台</td>\n            <td>5 台</td>\n            <td>20 台</td>\n          </tr>\n          <tr>\n            <th>线路与节点</th>\n            <td>普通线路节点池</td>\n            <td>全节点，含 IPLC 专线游戏加速优化</td>\n            <td>VIP 专属高带宽节点</td>\n          </tr>\n          <tr>\n            <th>流媒体解锁</th>\n            <td>基础流媒体解锁</td>\n            <td>全节点原生流媒体解锁</td>\n            <td>—</td>\n          </tr>\n          <tr>\n            <th>专属支持</th>\n            <td>—</td>\n            <td>7×24 优先工单支持</td>\n            <td>专属客户经理服务，支持企业定制路由</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n\n    <p class=\"note\">年付金额三档都相当于 10 个月的月付费用。表中标注“—”的项目在参考方案里未单独列出，请以购买渠道的完整说明为准；本页不构成下单、支付或退款承诺。</p>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"sec-head\">\n      <h2>客户端怎么选：按设备类型对号入座</h2>\n      <p>先把设备分四类，再决定装在哪里。本页不提供任何下载链接，只说明选择思路。</p>\n    </div>\n\n    <div class=\"cards\">\n      <article class=\"card\">\n        <h3>手机上用：iOS 与 Android</h3>\n        <p>手机是最好的起点。装好后把订阅信息导入客户端，名称建议写成“MLLSS + 档位名”，以后多份订阅混在一起也能一眼认出。系统切换、换机时记得把订阅信息一起迁移。</p>\n      </article>\n      <article class=\"card\">\n        <h3>电脑上用：Windows 与 macOS</h3>\n        <p>桌面端适合长时间挂着的场景，比如查资料、看视频、远程办公。电脑通常会被算作一台独立设备，和手机不要重复计。如果只是临时用一次，也可以先沿用浏览器里的手动代理设置。</p>\n      </article>\n      <article class=\"card\">\n        <h3>长期在线：路由器与电视盒</h3>\n        <p>路由器、电视盒这类设备一旦连上就很少断开，占用的就是长期名额。基础版只有 3 台同时在线，建议先算清常年开机的设备，再安排手机和电脑的顺序。</p>\n      </article>\n      <article class=\"card\">\n        <h3>下载地址从哪里拿</h3>\n        <p>客户端安装包的来源请以购买后收到的说明为准，本页不放任何下载地址。遇到来路不明的安装包不要输入账号或订阅信息，先核对其来源是否与你的渠道一致。</p>\n      </article>\n    </div>\n  </section>\n\n  <section id=\"guide\">\n    <div class=\"sec-head\">\n      <h2>使用说明：第一次连接的五步</h2>\n      <p>从上到下照着走一遍，基本就能完成首次配置。</p>\n    </div>\n\n    <ol class=\"steps\">\n      <li>\n        <span class=\"n\">01</span>\n        <div>\n          <h3>先核对套餐档位</h3>\n          <p>确认每月流量上限、同时在线设备数和线路说明，是否对得上你的实际用法。一个人日常上网，基础版通常够用；需要专线游戏加速就往上选一档；多设备或小团队一起用，再考虑团队版。</p>\n        </div>\n      </li>\n      <li>\n        <span class=\"n\">02</span>\n        <div>\n          <h3>保存好订阅信息</h3>\n          <p>拿到订阅链接或配置信息后，先在自己的笔记里存一份，不要只留在聊天记录里。换设备、重装客户端、增加第二台机器时都会再用到。</p>\n        </div>\n      </li>\n      <li>\n        <span class=\"n\">03</span>\n        <div>\n          <h3>按系统导入客户端</h3>\n          <p>在对应系统的客户端里导入这份订阅，命名写清档位与生效月份。如果手上有多个订阅，命名规范能省掉后面反复猜测的时间。</p>\n        </div>\n      </li>\n      <li>\n        <span class=\"n\">04</span>\n        <div>\n          <h3>首次连接先做一次延迟测试</h3>\n          <p>连上后不要急着用，先对可用线路做一次延迟测试，优先选响应时间短的那条。玩游戏或开实时通话时，再切到说明中标注了加速优化的线路。</p>\n        </div>\n      </li>\n      <li>\n        <span class=\"n\">05</span>\n        <div>\n          <h3>按并发上限分配设备</h3>\n          <p>基础版 3 台、旗舰版 5 台、团队版 20 台。先把长期在线的路由器、电视盒算进去，剩下的名额留给手机和电脑，避免临时要用时才发现名额满了。</p>\n        </div>\n      </li>\n    </ol>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"sec-head\">\n      <h2>常见问题</h2>\n      <p>关于套餐、流量、客户端和售后规则的八个问题，左右两栏各四组。</p>\n    </div>\n\n    <div class=\"faq\">\n      <article class=\"qa\">\n        <h3>MLLSS 有哪些套餐档位？</h3>\n        <p>参考方案里分三档：基础版 ¥15/月，每月 100GB 流量，支持 3 台设备同时在线；旗舰版 ¥35/月，每月 300GB，5 台设备；团队版 ¥85/月，每月 1000GB，20 台设备。具体权益以购买渠道页面为准。</p>\n      </article>\n      <article class=\"qa\">\n        <h3>年付比月付能省多少？</h3>\n        <p>按参考价格计算，三档的年付金额都正好等于 10 个月的月付费用，相当于多送两个月：基础版 ¥150/年、旗舰版 ¥350/年、团队版 ¥850/年。是否一次付一年，主要看你打算用多久。</p>\n      </article>\n      <article class=\"qa\">\n        <h3>当月流量用不完会结转到下个月吗？</h3>\n        <p>本页没有拿到流量结转或清零规则的可靠说明，因此不作推测。这类规则通常写在购买渠道的套餐详情里，建议直接查看或向渠道确认。</p>\n      </article>\n      <article class=\"qa\">\n        <h3>同时在线设备数怎么算？</h3>\n        <p>指同一时间保持连接的设备数量：基础版 3 台、旗舰版 5 台、团队版 20 台。路由器、电视盒这类长期开机的设备同样占用名额，规划时先把它们算进去。</p>\n      </article>\n      <article class=\"qa\">\n        <h3>客户端在哪里下载？</h3>\n        <p>本页不提供下载链接。客户端的获取方式以你购买后收到的说明为准。安装前请确认安装包来源与你的渠道一致，不要用来历不明的安装包输入订阅信息。</p>\n      </article>\n      <article class=\"qa\">\n        <h3>第一次用应该选哪条线路？</h3>\n        <p>先对可用线路做一轮延迟测试，优先选响应时间短的那条。如果主要用于游戏或实时通话，可以参考说明中标注了 IPLC 专线游戏加速优化的线路，这项在参考方案里属于旗舰版的描述。</p>\n      </article>\n      <article class=\"qa\">\n        <h3>团队版和另外两档差在哪里？</h3>\n        <p>从参考方案看，团队版的差别主要在容量和服务：每月 1000GB、20 台设备同时在线、VIP 专属高带宽节点、支持企业定制路由，另外配有专属客户经理服务。</p>\n      </article>\n      <article class=\"qa\">\n        <h3>购买后多久生效？不满意能退吗？</h3>\n        <p>本页没有生效时间与退款政策的可靠信息，因此不作推测，也不会代你承诺任何退款条件。这两项请直接查看购买渠道的说明，或向渠道方确认。</p>\n      </article>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <p><strong>MLLSS</strong> · 套餐、客户端与使用说明信息页</p>\n    <p>本页整理 MLLSS 相关套餐价格、客户端选择与上手步骤，不提供下载链接、支付入口或交易服务，也不代表品牌方的官方发布或授权。套餐价格与权益如与你的购买渠道页面不一致，请以购买渠道页面为准。</p>\n  </div>\n</footer>",
